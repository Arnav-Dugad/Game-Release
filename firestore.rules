rules_version = '2';

// Firestore security rules for LUDEX.
//
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Principles:
//  - A signed-in user may only ever write their own documents.
//  - Reviews are world-readable (they're public commentary) but the author is
//    pinned to the authenticated uid, so nobody can post under another name.
//  - Watchlists are private to their owner.
//  - Everything not matched below is denied by the final catch-all.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Profiles ---------------------------------------------------------
    // Private to the account holder. Reviews carry their own public author
    // snapshot, so exposing the profile document would only leak account data.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(uid);

      // --- Watchlist ------------------------------------------------------
      // Fully private: only the owner can read or write their tracked games.
      match /watchlist/{gameId} {
        allow read, write: if isOwner(uid);
      }

      // --- Settings -------------------------------------------------------
      // Display preferences (currency region, reduced motion). Private to the
      // owner: unlike the profile above, nothing here is shown to anyone else,
      // so there is no reason for it to be world-readable.
      match /settings/{document} {
        allow read, write: if isOwner(uid);
      }

      // --- Outbound notifications ---------------------------------------
      // Installation identifiers and delivery receipts are written only by
      // authenticated server routes using the Admin SDK. They must never be
      // writable from an untrusted browser, even by the owning account.
      match /pushSubscriptions/{subscriptionId} {
        allow read, write: if false;
      }

      match /notificationDeliveries/{deliveryId} {
        allow read, write: if false;
      }
    }

    // --- Reviews ----------------------------------------------------------
    // Document id is `{gameId}__{uid}`, which structurally enforces one review
    // per user per game. The rules additionally verify the embedded uid matches
    // the caller, so the id convention can't be worked around.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && reviewId == string(request.resource.data.gameId) + '__' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Price history ----------------------------------------------------
    // A price is a fact about the world, identical for every reader in a
    // region, so the series is shared rather than duplicated per user.
    //
    // World-readable, and writable by any signed-in user — observations are
    // contributed by whoever happens to view a game that day, which is what
    // builds the history without a server-side scheduler. Writes are
    // constrained to one document per app/region/day and to the expected
    // shape, and existing points are immutable, so a client cannot rewrite
    // history or inject a fake "all-time low".
    match /prices/{series}/points/{date} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.date == date
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0
        && request.resource.data.discountPercent is int
        && request.resource.data.discountPercent >= 0
        && request.resource.data.discountPercent <= 100
        && request.resource.data.formatted is string
        && request.resource.data.formatted.size() <= 32;

      // Recorded prices are never edited or removed; a day's observation is
      // either taken or it isn't.
      allow update, delete: if false;
    }

    // --- Default deny -----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
