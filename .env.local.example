# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. On Vercel, add the same keys
# under Project → Settings → Environment Variables.
#
# Nothing here is required to run the app. With no variables set, LUDEX serves
# its bundled sample catalogue and reports auth as unavailable — every page
# still renders.
# ---------------------------------------------------------------------------


# --- Game data (optional) --------------------------------------------------
# Free key from https://rawg.io/apidocs (20,000 requests/month).
# Setting this switches the whole site from the sample catalogue to the live
# release calendar, with real artwork, screenshots, trailers and store links.
# Server-side only — never exposed to the browser.
RAWG_API_KEY=


# --- Firebase (optional) ---------------------------------------------------
# Enables sign-in, watchlists and reviews. Create a project at
# https://console.firebase.google.com, add a Web App, and paste its config here.
#
# Then, in the Firebase console:
#   1. Authentication → Sign-in method → enable "Email/Password" and "Google"
#   2. Firestore Database → create a database
#   3. Firestore → Rules → paste the contents of `firestore.rules`
#   4. Authentication → Settings → Authorised domains → add your Vercel domain
#
# These are NEXT_PUBLIC_* because the Firebase web SDK runs in the browser.
# That is expected and safe: Firebase web config is public by design, and access
# is controlled by the Firestore security rules, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# --- Site URL (recommended for production) ---------------------------------
# Used for canonical URLs, sitemap.xml and social card images.
# Example: https://ludex.vercel.app  (no trailing slash)
NEXT_PUBLIC_SITE_URL=
